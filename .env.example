# ─── Servidor ────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Orígenes permitidos separados por coma (vacío = todos, solo para desarrollo)
CORS_ORIGINS=

# ─── Base de datos (PostgreSQL) ──────────────────────────
# Local con docker compose: postgresql://baleadafit:baleadafit@localhost:5432/baleadafit
# Railway: usar la variable DATABASE_URL del servicio Postgres
DATABASE_URL=postgresql://baleadafit:baleadafit@localhost:5432/baleadafit

# ─── Firebase Admin (Consola Firebase → Configuración → Cuentas de servicio) ─
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pegar en una línea con \n literales
FIREBASE_PRIVATE_KEY=

# Solo desarrollo: acepta "Authorization: Bearer dev:<uid>:<correo>" sin Firebase.
# Se ignora si NODE_ENV=production.
AUTH_DEV_BYPASS=false

# ─── AWS Bedrock (recomendador de dietas) ────────────────
IA_HABILITADA=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ID del modelo o inference profile habilitado en tu cuenta (Consola Bedrock → Model access)
BEDROCK_MODEL_ID=
